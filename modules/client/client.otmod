Module
  name: client
  description: Initialize the client and setups its main window
  author: edubart
  website: https://github.com/edubart/otclient
  reloadable: false
  sandboxed: true
  scripts: [ client ]
  @onLoad: init()
  @onUnload: terminate()

  load-later:
    - client_styles
    - client_locales
    - client_topmenu
    - client_bottommenu
    - client_background
    - client_options
    - client_entergame
    # client_terminal removed: it was a loadstring console on Ctrl+T whose
    # environment falls through to _G, so g_game.attack, g_game.talk and
    # cycleEvent were all one line away. That is a bot with a nicer name.
    - client_debug_info
    - client_serverlist
