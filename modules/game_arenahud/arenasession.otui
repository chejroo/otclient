// The prep and results window, opcode 177. One window for both, because they
// are the same shape: a title, a deadline, a list of rows and two buttons. Two
// windows would be two layouts to keep in step for one difference in wording.
//
// Rows are created in Lua rather than declared here. The conditions strip, the
// key legend and the player list are all variable length and all come off the
// wire, so declaring them would mean a fixed number of hidden labels and a
// silent truncation the day a champion gains a seventh key.

// text-auto-resize with text-wrap rather than a fixed height, because the rules
// lines are server text of no promised length. A fixed height truncates them
// silently, which for a window whose whole job is telling the player the rules
// is the worst way to fail.
SessionRow < Label
  text-align: left
  text-wrap: true
  text-auto-resize: true
  color: #c0c0c0ff
  font: verdana-11px-rounded
  margin-left: 2

SessionHeading < Label
  text-align: left
  text-wrap: true
  text-auto-resize: true
  color: #e0a33cff
  font: verdana-11px-rounded
  margin-top: 6
  margin-left: 2

// The champion picker. A Button rather than a styled Label, because Button
// already carries the $on state that draws it pressed, which is the whole of
// "this is the one you have chosen", and because a thing you click should look
// like a thing you click.
//
// Rows are only drawn when the roster holds more than one champion. With one
// card a picker is a button whose only effect is to confirm what is already
// true.
SessionPick < Button
  height: 20
  text-align: left
  text-offset: 6 2
  margin-left: 2
  margin-top: 2

// auto-focus: none, and it is not cosmetic. Walk keys are bound to
// game_interface's root panel, and a g_keyboard binding only fires while that
// widget's subtree holds focus. UIWindow.create sets AutoFocusFirst, so showing
// this window would take focus off the game panel and kill walking, during the
// exact thirty seconds the player is meant to be walking to the gate and trying
// their spells. Clicking the window still focuses it, which is what makes the
// Escape hook below reachable.
MainWindow
  id: arenaSessionWindow
  !text: tr('Arena')
  size: 320 400
  visible: false
  auto-focus: none
  @onEscape: modules.game_arenahud.onSessionEscape()

  Label
    id: headline
    !text: ''
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 2
    height: 18
    text-align: center
    color: #ffffffff
    font: verdana-11px-rounded

  Label
    id: deadline
    !text: ''
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: headline.bottom
    height: 14
    text-align: center
    color: #808080ff
    font: verdana-11px-rounded

  HorizontalSeparator
    id: sep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: deadline.bottom
    margin-top: 4

  // Anchored to the same things `body` is anchored to, never to `body` itself.
  // It used to take its top and bottom from body.top and body.bottom while body
  // took its right edge from bodyScroll.left, and that pair is a cycle:
  // UIAnchorLayout::updateWidget walks the chain, arrives back at the widget it
  // started from and gives up with "recursively anchored to itself", once per
  // widget per layout pass. The window still drew, so it only ever showed up as
  // a flood in the client log.
  //
  // Every scrollbar in the stock client does it this way, debug_info.otui and
  // characterlist.otui included: the bar anchors to the parent, and the panel
  // anchors its right edge to the bar.
  VerticalScrollBar
    id: bodyScroll
    anchors.top: sep.bottom
    anchors.bottom: primary.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 8
    step: 14
    pixels-scroll: true

  // **No fit-children here, and that is the whole of this layout.** The anchors
  // own this panel's height, top to bottom between the separator and the
  // buttons. fit-children would make the box layout own it too, and the two
  // fight: UIVerticalLayout defers a setHeight to the content height, the
  // anchor layout sets it straight back, and neither side has a guard, so it
  // ping-pongs every frame for the life of the window. The visible cost is not
  // just churn: the panel is continually resized to its own content, so the
  // scroll range is always about zero and the wheel does nothing, which is
  // exactly what the scrollbar was added for.
  //
  // MiniWindowContents in data/styles/30-miniwindow.otui is the pattern being
  // copied, down to anchoring the right edge to the scrollbar's left rather
  // than to the parent, which is what keeps the bar off the text.
  ScrollablePanel
    id: body
    anchors.left: parent.left
    anchors.right: bodyScroll.left
    anchors.top: sep.bottom
    anchors.bottom: primary.top
    margin-top: 6
    margin-bottom: 8
    margin-left: 4
    margin-right: 2
    vertical-scrollbar: bodyScroll
    layout:
      type: verticalBox

  // Confirm on the right, cancel on the left, everywhere in this client. The
  // ids stay primary and secondary because the key handlers are named after
  // them; only the side they sit on moves. secondary is always Leave and
  // primary is always the affirmative, Ready in prep and Play again on the
  // results screen, so the sides hold in every state the window has.
  Button
    id: secondary
    !text: tr('Leave')
    color: #ffffffff
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 3
    @onClick: modules.game_arenahud.onSessionSecondary()

  Button
    id: primary
    !text: tr('Ready')
    color: #ffffffff
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 3
    @onClick: modules.game_arenahud.onSessionPrimary()
