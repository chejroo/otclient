PhantomMiniWindow
  id: arenaHudPanel
  draggable: true
  phantom: false
  # 382 before the kit bar, plus its 4 of margin and 36 of row. game_mainpanel
  # writes this value straight back onto the panel in reloadMainPanelSizes, so
  # it has to be the full height rather than the one refresh() measures.
  &panelHeight: 422
  height: 422

  HorizontalSeparator
    id: sep0
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-right: 6
    margin-top: 4

  Label
    id: state
    !text: 'IDLE'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: sep0.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 5
    text-align: center
    color: #808080ff
    font: verdana-11px-rounded

  Label
    id: banner
    !text: ''
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: state.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 4
    height: 16
    text-align: center
    color: #e0a33cff
    font: verdana-11px-rounded

  Label
    id: clock
    !text: '0:00'
    anchors.left: parent.left
    anchors.top: banner.bottom
    margin-left: 8
    margin-top: 5
    width: 60
    text-align: left
    color: #ffffffff
    font: verdana-11px-rounded

  Label
    id: phase
    !text: '-'
    anchors.right: parent.right
    anchors.top: banner.bottom
    margin-right: 8
    margin-top: 5
    width: 90
    text-align: right
    color: #c0c0c0ff

  Label
    id: scoreCaption
    !text: 'Score'
    anchors.left: parent.left
    anchors.top: clock.bottom
    margin-left: 8
    margin-top: 4
    width: 44
    color: #9e9e9eff

  Label
    id: score
    !text: '0'
    anchors.left: scoreCaption.right
    anchors.right: parent.right
    anchors.top: clock.bottom
    margin-right: 8
    margin-top: 4
    text-align: right
    color: #e0e0e0ff

  Label
    id: comboCaption
    !text: 'Combo'
    anchors.left: parent.left
    anchors.top: score.bottom
    margin-left: 8
    margin-top: 2
    width: 44
    color: #9e9e9eff

  Label
    id: combo
    !text: 'x0'
    anchors.left: comboCaption.right
    anchors.right: parent.right
    anchors.top: score.bottom
    margin-right: 8
    margin-top: 2
    text-align: right
    color: #e0e0e0ff

  # Drains over ArenaConfig.hunt.comboWindow after every kill. Hidden rather
  # than emptied when no chain is live, because UIProgressBar:updateBackground
  # floors the fill at one pixel, so a bar at 0% still shows a sliver and reads
  # as "a tiny bit of time left" when the honest answer is none.
  ProgressBar
    id: comboBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: combo.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 2
    height: 8
    visible: false
    background-color: #5ac85aff

  Label
    id: oppCaption
    !text: 'Rival'
    anchors.left: parent.left
    anchors.top: comboBar.bottom
    margin-left: 8
    margin-top: 2
    width: 44
    color: #9e9e9eff

  Label
    id: opp
    !text: '-'
    anchors.left: oppCaption.right
    anchors.right: parent.right
    anchors.top: comboBar.bottom
    margin-right: 8
    margin-top: 2
    text-align: right
    color: #e0e0e0ff

  Label
    id: link
    !text: 'no run'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: opp.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 3
    text-align: center
    color: #8c8c8cff

  # The kit bar. Six ArenaKitSlot children are created here by arenahud.lua
  # rather than written out six times, and a horizontalBox lays them out so the
  # slot widths are the only number that has to add up: 6 slots of 24 plus 5
  # gaps of 4 is 164, which is the 176 of a GameSidePanel less the 6 of margin
  # each side. The layout expands a child's height to the row, so a slot is
  # 24x36 and its 24 high icon plus 12 high key label fill it exactly.
  #
  # Always visible, because the deferred height measurement in refresh() reads
  # the visible children and a row that appeared and vanished would move every
  # dev button under it on every run. Empty is the idle look, not hidden.
  UIWidget
    id: kitRow
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: link.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 4
    height: 36
    focusable: false
    layout:
      type: horizontalBox
      spacing: 4

  HorizontalSeparator
    id: sep1
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: kitRow.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 5

  ArenaButton
    id: startButton
    !text: 'Start'
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: sep1.bottom
    margin-left: 6
    margin-right: 2
    margin-top: 5

  ArenaButton
    id: stopButton
    !text: 'Stop'
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: sep1.bottom
    margin-left: 2
    margin-right: 6
    margin-top: 5

  ArenaButton
    id: statusButton
    !text: 'Status'
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: startButton.bottom
    margin-left: 6
    margin-right: 2
    margin-top: 3

  ArenaButton
    id: probeButton
    !text: 'Probe'
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: stopButton.bottom
    margin-left: 2
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: telegraphButton
    !text: 'Telegraph'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: statusButton.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: eliteButton
    !text: 'Spawn elite'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: telegraphButton.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: aimButton
    !text: 'Give aim rune'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: eliteButton.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: simButton
    !text: 'Score sim'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: aimButton.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 3

  Label
    id: mapCaption
    !text: 'map tools'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: simButton.bottom
    margin-top: 5
    text-align: center
    color: #8c8c8cff

  ArenaButton
    id: mapcheckButton
    !text: 'Check'
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: mapCaption.bottom
    margin-left: 6
    margin-right: 2
    margin-top: 3

  ArenaButton
    id: mapscanButton
    !text: 'Scan'
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: mapCaption.bottom
    margin-left: 2
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: mapclearButton
    !text: 'Clear'
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: mapcheckButton.bottom
    margin-left: 6
    margin-right: 2
    margin-top: 3

  ArenaButton
    id: gotoButton
    !text: 'Go to'
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: mapscanButton.bottom
    margin-left: 2
    margin-right: 6
    margin-top: 3

  ArenaButton
    id: backButton
    !text: 'Back'
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: mapclearButton.bottom
    margin-left: 6
    margin-right: 2
    margin-top: 3

  ArenaButton
    id: homeButton
    !text: 'Home'
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.top: gotoButton.bottom
    margin-left: 2
    margin-right: 6
    margin-top: 3
